generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String    @default("USER")
  isVerified     Boolean   @default(false)
  otpCode        String?
  otpExpiresAt   DateTime?
  organizationId String?   @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs      AuditLog[]
}

model Organization {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  leads         Lead[]
  campaigns     Campaign[]
  emailAccounts EmailAccount[]
}

model Lead {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String              @db.ObjectId
  organization       Organization        @relation(fields: [organizationId], references: [id])

  firstName          String?
  lastName           String?
  fullName           String?
  jobTitle           String?
  email              String
  phone              String?

  companyName        String?
  companyWebsite     String?
  domain             String?
  industry           String?
  location           String?
  companySize        String?

  source             String?
  sourceIdentifier   String?
  linkedInUrl        String?

  verificationStatus String              @default("UNVERIFIED")
  leadScore          Int                 @default(0)
  confidence         Int?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  enrichmentData     LeadEnrichment[]
  campaigns          CampaignRecipient[]
  replies            Reply[]
}

model LeadEnrichment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId     String   @db.ObjectId
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  provider   String
  data       String
  confidence Int?
  createdAt  DateTime @default(now())
}

model Campaign {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String              @db.ObjectId
  organization   Organization        @relation(fields: [organizationId], references: [id])
  name           String
  status         String              @default("DRAFT")

  timezone       String              @default("UTC")
  dailyLimit     Int                 @default(100)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  steps          CampaignStep[]
  recipients     CampaignRecipient[]
}

model CampaignStep {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  campaignId   String          @db.ObjectId
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sequence     Int
  subject      String
  contentHtml  String
  contentPlain String
  delayDays    Int             @default(0)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  emailMessages EmailMessage[]
}

model CampaignRecipient {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String         @db.ObjectId
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String         @db.ObjectId
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status        String         @default("PENDING")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  emailMessages EmailMessage[]
}

model EmailAccount {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  organization   Organization   @relation(fields: [organizationId], references: [id])
  fromName       String
  fromEmail      String
  replyTo        String?

  smtpHost       String
  smtpPort       Int
  smtpSecure     Boolean        @default(true)
  smtpUser       String
  smtpPassword   String

  isActive       Boolean        @default(true)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  emailMessages  EmailMessage[]
}

model EmailMessage {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  campaignStepId      String?            @db.ObjectId
  campaignStep        CampaignStep?      @relation(fields: [campaignStepId], references: [id])
  campaignRecipientId String?            @db.ObjectId
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id])
  emailAccountId      String             @db.ObjectId
  emailAccount        EmailAccount       @relation(fields: [emailAccountId], references: [id])

  messageId           String?
  status              String             @default("QUEUED")
  sentAt              DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  events              EmailEvent[]
}

model EmailEvent {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  emailMessageId String        @db.ObjectId
  emailMessage   EmailMessage  @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  eventType      String
  metadata       String?
  createdAt      DateTime      @default(now())
}

model Reply {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId     String    @db.ObjectId
  lead       Lead      @relation(fields: [leadId], references: [id])
  messageId  String?
  content    String
  receivedAt DateTime  @default(now())
}

model AuditLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?   @db.ObjectId
  user       User?     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime  @default(now())
}