# Environment variables for Backend

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://your-app.vercel.app

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_outreach_db?schema=public"

# Redis (Queue)
REDIS_URL="redis://localhost:6379"

# Security
SESSION_SECRET="super_secret_session_key_change_in_production"
JWT_SECRET="super_secret_jwt_key_change_in_production"

# Email Services (Testing Default)
EMAIL_MODE=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=test_user
SMTP_PASSWORD=test_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Lead Platform"

# API Keys (Providers)
AI_API_KEY=""
LEAD_PROVIDER_API_KEY=""
EMAIL_VERIFICATION_API_KEY=""
